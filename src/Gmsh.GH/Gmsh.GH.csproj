<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>false</Deterministic>
    <Nullable>enable</Nullable>
    <TargetExt>.gha</TargetExt>
    <RootNamespace>GmshCommon.GH</RootNamespace>
    <AssemblyName>Gmsh.GH</AssemblyName>
    <BaseOutputPath>..\..\bin</BaseOutputPath>
    <OutputPath>..\..\bin</OutputPath>
    <!--
      The old Properties\AssemblyInfo.cs still sets AssemblyVersion/AssemblyTitle/etc.
      by hand. Leave that file as-is and turn off the SDK's own auto-generated
      AssemblyInfo, otherwise the build fails with duplicate-attribute errors
      (CS0579) once both exist.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TODO (verify in Visual Studio): pinned to the same RhinoCommon build GmshRhino
      already uses elsewhere in this solution, for consistency. Confirm a matching
      "Grasshopper" package version is actually available/restorable for you -
      check the NuGet browser in VS if restore fails here.
    -->
    <PackageReference Include="RhinoCommon" Version="8.10.24226.13001" />
    <PackageReference Include="Grasshopper" Version="8.10.24226.13001" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmshCommon\GmshCommon.vcxproj" />
    <ProjectReference Include="..\GmshRhino\GmshRhino.csproj" />
  </ItemGroup>

</Project>
